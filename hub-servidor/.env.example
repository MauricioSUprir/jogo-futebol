# Conexão com o banco Postgres (obrigatório em produção).
# Ex. Neon:     postgres://user:senha@ep-xxx.neon.tech/hub?sslmode=require
# Ex. Railway:  postgres://user:senha@host.proxy.rlwy.net:5432/railway
DATABASE_URL=postgres://user:senha@localhost:5432/hub

# Segredo pra assinar os cookies de sessão. Gere um valor aleatório e secreto:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-secreto

# Porta do servidor (a maioria das plataformas define automaticamente).
PORT=3000
