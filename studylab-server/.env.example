# ---- obrigatórias ----
ANTHROPIC_API_KEY=sk-ant-...          # a SUA chave (fica só aqui, nunca no app)
SEGREDO=troque-por-uma-frase-longa    # assina as sessões dos alunos
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# ---- banco ----
# No Railway, adicione o plugin Postgres e ele preenche DATABASE_URL sozinho.
# Sem DATABASE_URL o servidor roda em memória (só para testar na sua máquina).
DATABASE_URL=

# ---- pagamento (Mercado Pago) ----
# Sem estas variáveis o app só libera o Pro por código de acesso.
MP_ACCESS_TOKEN=APP_USR-...           # Credenciais de produção -> Access token (privada)
MP_PUBLIC_KEY=APP_USR-...             # Public key: monta o formulário do cartão dentro do app
MP_WEBHOOK_SECRET=                    # "Assinatura secreta" do webhook (confere os avisos)
URL_WEBHOOK=                          # opcional: no Railway é descoberto sozinho
URL_APP=https://mauriciosuprir.github.io/jogo-futebol/studylab/

# ---- opcionais ----
PORT=3000
ORIGENS=https://mauriciosuprir.github.io,http://localhost:5173
# --- IA: escolha UMA das chaves (ou as duas) -------------------------------
# GRÁTIS para testar: crie em https://aistudio.google.com (sem cartão).
# O limite do plano grátis é do app inteiro, então para escala use a Claude.
GEMINI_API_KEY=
# Paga por uso (console.anthropic.com). Com as duas chaves, a Claude vence.
# PROVEDOR=gemini força o Gemini mesmo com a chave da Claude configurada.
MODELO_GEMINI=gemini-2.5-flash
MODELO=claude-haiku-4-5              # padrão: é o que dá lucro nos planos (opus/sonnet custam mais)
MODELO_PLUS=                          # opcional: um modelo melhor SÓ para o Plus (ex.: claude-sonnet-5)
LIMITE_DIARIO=30                      # perguntas por dia (Pro)
LIMITE_MENSAL=400                     # teto do mês (Pro)
LIMITE_DIARIO_PLUS=80                 # perguntas por dia (Plus)
LIMITE_MENSAL_PLUS=1000               # teto do mês (Plus)
FOTOS_DIA=5                           # fotos por dia (Pro)
FOTOS_DIA_PLUS=25                     # fotos por dia (Plus)
ADMIN_TOKEN=                          # necessário para criar códigos pela API
