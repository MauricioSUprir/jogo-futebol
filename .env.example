# ---- Banco de dados (Postgres) ----
DATABASE_URL=postgres://studio:studio@localhost:5432/studio

# ---- Auth.js ----
# Gere um segredo com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-segredo-aleatorio
# Em produção, use a URL pública da aplicação (ex.: https://studio.seudominio.com)
AUTH_URL=http://localhost:3000
# Confie no host atrás do proxy do VPS
AUTH_TRUST_HOST=true

# ---- Claude API (usado APENAS no servidor; nunca exposto ao client) ----
ANTHROPIC_API_KEY=coloque-sua-chave-aqui
# Modelo usado nas sugestões de roteiro
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Seed do admin inicial (usado por npm run db:seed) ----
SEED_ADMIN_EMAIL=admin@studio.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NOME=Criadora
# Editor opcional de exemplo
SEED_EDITOR_EMAIL=editor@studio.local
SEED_EDITOR_PASSWORD=editor123

# ---- Localização ----
TZ=America/Sao_Paulo
