# Copie para .env e preencha. NUNCA envie o .env para o Git.
# Gerar valores aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   (chave de 32 bytes)
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"      (senhas e códigos)

# ── Docker Compose ──
POSTGRES_PASSWORD=""
# Porta local do app (o Tailscale Serve/Caddy aponta para ela)
LIFEOS_PORTA=3000
BACKUP_MANTER_DIAS=14

# ── App ──
# Banco (só para rodar FORA do Docker; no Compose ela é montada sozinha)
DATABASE_URL="postgresql://lifeos:troque-esta-senha@localhost:5432/lifeos"

# Chave de criptografia dos campos sensíveis: 32 bytes em base64. Guarde uma cópia: sem ela, a
# verificação em duas etapas precisa ser configurada de novo.
LIFEOS_ENCRYPTION_KEY=""

# Código de configuração: só quem tem este código cria a conta (uma vez só).
LIFEOS_SETUP_TOKEN=""

# "1" atrás de um proxy confiável (Tailscale Serve, Caddy, Nginx): usa o IP real no registro de acessos.
LIFEOS_TRUST_PROXY="1"

# "0" só para testar em http:// fora do localhost (o cookie de sessão deixa de exigir HTTPS).
LIFEOS_COOKIE_SECURE="1"
