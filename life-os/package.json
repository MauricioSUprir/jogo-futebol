{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "description": "LIFE OS — sistema operacional pessoal (privado, com servidor próprio)",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/preparar-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/fluxo.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "pg": "^8.16.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "tailwind-merge": "^3.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
