{
  "rules": {
    "leiloes": {
      "$c": {
        ".validate": "(!data.child('vivo').exists() || newData.child('vivo').exists()) && (!data.child('lotes').exists() || newData.child('lotes').exists() || data.child('sala/meta/estado').val() === 'saguao') && (!data.child('sala').exists() || newData.child('sala').exists())",
        "sala": {
          ".validate": "newData.hasChildren(['meta', 'cfg', 'tec'])",
          "meta": {
            ".validate": "newData.hasChildren(['dono', 'estado', 'regras', 'criada'])",
            "dono": { ".validate": "!data.exists() || newData.val() === data.val()" },
            "estado": { ".validate": "newData.isString() && newData.val().matches(/^(saguao|leilao|escalacao|camp|fim)$/)" },
            "regras": { ".validate": "newData.isNumber()" },
            "criada": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "atividade": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "fimLeilao": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "camp": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "fimCamp": { ".validate": "newData.val() === now || newData.val() === data.val()" }
          },
          "tec": {
            "$uid": {
              ".validate": "!data.child('auth').exists() || newData.child('auth').exists()",
              "auth": { ".validate": "newData.val() === data.val() || (!data.exists() && (newData.val() === auth.uid || newData.val() === root.child('leiloes').child($c).child('sala/pedidos').child($uid).child('auth').val()))" }
            }
          },
          "pedidos": {
            "$uid": {
              ".validate": "(!data.exists() && newData.child('auth').val() === auth.uid) || (data.exists() && newData.child('auth').val() === data.child('auth').val())",
              "ts": { ".validate": "newData.val() === now || newData.val() === data.val()" }
            }
          }
        },
        "lotes": {
          ".validate": "!data.exists() || root.child('leiloes').child($c).child('sala/meta/estado').val() === 'saguao'"
        },
        "vivo": {
          ".validate": "!data.exists() || (newData.child('seq').val() >= data.child('seq').val() && (newData.child('seq').val() !== data.child('seq').val() || (newData.child('valor').val() >= data.child('valor').val() && (newData.child('n').val() === data.child('n').val() || ((data.child('fase').val() === 'rep' && (now < data.child('abre').val() + 7500 || now < data.child('t').val() + 6000)) || (data.child('fase').val() !== 'rep' && (now < data.child('abre').val() + 1500 + root.child('leiloes').child($c).child('sala/cfg/tempo').val() || now < data.child('t').val() + 8000)))))))",
          "abre": { ".validate": "newData.val() === now || newData.val() === data.val()" },
          "t": { ".validate": "newData.val() === now || newData.val() === data.val() || newData.val() === 0" }
        },
        "vendas": {
          "$i": { ".validate": "!data.exists()" }
        },
        "escal": {
          "$t": { ".validate": "root.child('leiloes').child($c).child('sala/tec').child(root.child('leiloes').child($c).child('sala/ordem').child($t).val()).child('auth').val() === auth.uid" }
        },
        "bate": {
          "$uid": {
            ".validate": "newData.hasChildren(['ts', 'sid']) && root.child('leiloes').child($c).child('sala/tec').child($uid).child('auth').val() === auth.uid",
            "ts": { ".validate": "newData.val() === now" },
            "desde": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "sid": { ".validate": "newData.isString()" },
            "n": { ".validate": "newData.isString()" },
            "ant": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "cont": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "falta": { ".validate": "newData.isNumber() && newData.val() <= now" }
          }
        },
        "pres": {
          "$uid": {
            ".validate": "root.child('leiloes').child($c).child('sala/tec').child($uid).child('auth').val() === auth.uid",
            "$k": { ".validate": "newData.isBoolean()" }
          }
        },
        "jogos": {
          "$j": {
            ".validate": "newData.hasChildren(['e']) && (!data.exists() || data.child('e').val() !== 'feito') && (newData.child('e').val() !== 'aberto' || !data.exists() || data.child('e').val() === 'aberto') && (newData.child('e').val() !== 'reservado' || !data.exists() || data.child('e').val() === 'aberto' || (data.child('e').val() === 'reservado' && data.child('modo').val() === '3d' && !data.child('abriu').exists() && newData.child('abriu').val() === now && newData.child('trava').val() === data.child('trava').val() && newData.child('modo').val() === '3d' && newData.child('por').val() === data.child('por').val() && newData.child('motivo').val() === data.child('motivo').val() && newData.child('inicio').val() === data.child('inicio').val())) && (newData.child('e').val() !== 'feito' || (data.child('e').val() === 'reservado' && newData.child('trava').val() === data.child('trava').val())) && (newData.child('e').val() !== 'reservado' || newData.child('motivo').val() !== 'prazo' || (data.child('ini').exists() && now >= data.child('ini').val() + data.child('resta').val()))",
            "e": { ".validate": "newData.isString() && newData.val().matches(/^(aberto|reservado|feito)$/)" },
            "ini": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "resta": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000 && (!data.exists() || newData.val() <= data.val())" },
            "trava": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "inicio": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "abriu": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "ts": { ".validate": "newData.val() === now || newData.val() === data.val()" },
            "res": { ".validate": "!data.exists()" }
          }
        }
      }
    }
  }
}
