# ============ Supabase (Settings → API do seu projeto) ============
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-ou-publishable
# Só no servidor (Vercel → Environment Variables, nunca no navegador):
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# Endereço público do site (links de convite, QR Code e e-mails)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Login com Google: 1 depois de ligar o provedor Google no Supabase (Authentication → Providers)
NEXT_PUBLIC_AUTH_GOOGLE=0
# Participar sem cadastro (login anônimo do Supabase: Authentication → Sign In / Providers → Allow anonymous sign-ins)
NEXT_PUBLIC_AUTH_ANONYMOUS=1

# E-mail de contato mostrado na Política de Privacidade e nos Termos
CONTATO_EMAIL=contato@seu-dominio.com.br

# Cron (sorteios agendados, lembretes e entrega de e-mail/push). A Vercel manda este segredo no cabeçalho.
CRON_SECRET=gere-um-valor-aleatorio

# ============ E-mail das notificações (opcional: um dos três) ============
EMAIL_FROM="Amigo Oculto <nao-responda@seu-dominio.com.br>"
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_URL=

# ============ Push (opcional): npm run vapid ============
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com.br
