# ---- obrigatória ----
# A SUA chave. Ela fica só aqui, no servidor — nunca chega ao navegador de ninguém.
# Grátis em https://aistudio.google.com/apikey (não pede cartão).
GEMINI_API_KEY=

# Alternativa paga (console.anthropic.com). Com as duas, o Gemini vence,
# a menos que você defina PROVEDOR=anthropic.
ANTHROPIC_API_KEY=
PROVEDOR=

# ---- opcionais ----
PORT=3000

# Quem pode chamar este servidor. O navegador respeita isso; um script não,
# e é por isso que os limites abaixo existem.
ORIGENS=https://mauriciosuprir.github.io,http://localhost:8000

MODELO_GEMINI=gemini-2.5-flash
MODELO_ANTHROPIC=claude-haiku-4-5-20251001

# Freio de mão: protege a sua camada gratuita de uso automatizado.
LIMITE_MINUTO=6          # perguntas por minuto, por IP
LIMITE_DIA_IP=40         # perguntas por dia, por IP
LIMITE_DIA_TOTAL=800     # teto do servidor inteiro por dia

# Opcional: exige um cabeçalho "x-senha" para responder. Serve para deixar o
# servidor só para você, sem deixar de ser público na internet.
SENHA=
